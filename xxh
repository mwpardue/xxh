#!/usr/bin/env bash

s_flag=0
SPLIT_KEY=";"

# ============================================================================
# Helper Functions - Consolidate tmux + SSH commands
# ============================================================================

# Set pane title to hostname
set_pane_title() {
  local hostname="$1"
  tmux select-pane -T "$hostname"
}

# Create a new SSH window with auto-switch
# Used for default (single window per host) mode
create_ssh_window() {
  local hostname="$1"
  tmux new-window -n "$hostname" ssh "$hostname"
  tmux set pane-border-format "#{pane_title}"
  set_pane_title "$hostname"
}

# Create a new SSH window and return target for pane operations
# Used for '-s' flag mode to add multiple panes to one window
create_ssh_window_targeted() {
  local hostname="$1"
  tmux new-window -n "$hostname" ssh "$hostname"
  tmux set pane-border-format "#{pane_title}"
  set_pane_title "$hostname"
  sleep 0.5
  tmux display-message -p '#{session_name}:#{window_index}'
}

# Create a new SSH pane (split) in existing target
# Automatically sets pane title to hostname
create_ssh_pane() {
  local target="$1"
  local hostname="$2"
  tmux split-window -t "$target" -h ssh "$hostname"
  tmux select-pane -t "$target" -T "$hostname"
  sleep 0.5
}

while getopts "sk:" opt; do
  case $opt in
  s)
    s_flag=1
    ;;
  k)
    SPLIT_KEY="$OPTARG"
    ;;
  \?) ;;
  esac
done

LABEL=" Secure Shell Connections "
if [[ s_flag -eq 1 ]]; then
  LABEL=" Secure Shell Connections (Split-Windows) "
fi
client_width=$(tmux display-message -p '#{client_width}')
fzf_width=$(($client_width * 30 / 100))

dir="$HOME/.ssh"

mapfile -t list < <(
  grep -Ehs '^Host .*#' "$dir"/config* "$dir"/config.d/config* |
    awk -v width="$fzf_width" '{
      host = $2
      if (idx = index($0, " #")) {
        desc = substr($0, idx + 2)
      } else {
        desc = host
      }
      padding = width - length(host) - 6
      if (padding < 1) padding = 1
      printf "%s%*s\n", host, padding, desc
    }'
)

# fzf_height=$((${#list[@]} + 4))
fzf_height=30
FMENU=(
  fzf
  --tmux $fzf_width,$fzf_height
  --layout=reverse
  --margin=0,0
  --padding=0,1,0,0
  --border=sharp
  --border=rounded
  --border-label="$LABEL"
  --border-label-pos=center
  --no-info
  --input-border=line
  --no-separator
  --scrollbar=▐
  --pointer=''
  --multi
  --color 'fg:7'
  --color 'bg:16'
  --color 'current-fg:16'
  --color 'current-bg:10'
  --color 'hl:9'
  --color 'current-hl:9'
  --color 'border:12'
  --color 'label:11'
  --color 'header:7'
  --color 'prompt:11'
  --color 'marker:11'
  --color 'input-border:5'
  --color 'scrollbar:7'
  --bind change:top
  --ansi
  --expect="$SPLIT_KEY"
  --prompt
)

selected_row=$(printf "%s\n" "${list[@]}" | "${FMENU[@]}" "HOST> ")
if [[ -n "$selected_row" ]]; then
  key=$(printf '%s\n' "$selected_row" | head -n1)
  hosts_raw=$(printf '%s\n' "$selected_row" | tail -n +2)

  selection_array=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && selection_array+=("$line")
  done <<<"$hosts_raw"

  if [[ "$key" == "$SPLIT_KEY" ]]; then
    for i in "${selection_array[@]}"; do
      hostname="${i%% *}"
      tmux split-window -h ssh "$hostname"
      set_pane_title "$hostname"
      sleep 0.3
    done

    if [[ ${#selection_array[@]} -le 2 ]]; then
      tmux select-layout even-horizontal
    else
      tmux select-layout tiled
    fi

  elif [[ s_flag -eq 1 ]]; then
    list_length=${#selection_array[@]}
    panes=4
    windows=$((($list_length + panes - 1) / panes))
    window_idx=0

    # If only one host is selected, open it in a new pane without creating a new window
    if [[ $list_length -eq 1 ]]; then
      hostname="${selection_array[0]%% *}"
      tmux split-window -h ssh "$hostname"
      set_pane_title "$hostname"

    # If more than one host multi-selected, open in new windows with panes
    else
      while [[ $window_idx -lt $windows ]]; do
        for ((pos = 0; pos < panes && (window_idx * panes + pos) < list_length; pos++)); do
          idx=$(((window_idx * panes + pos) % list_length))
          item="${selection_array[$idx]}"
          hostname="${item%% *}"
          if [[ $pos -eq 0 ]]; then
            target=$(create_ssh_window_targeted "$hostname")
            continue
          else
            create_ssh_pane "$target" "$hostname"
          fi
        done
        if [[ $list_length == 2 ]]; then
          tmux select-layout -t "$target" even-horizontal
        else
          tmux select-layout tiled
        fi
        ((++window_idx))
      done
    fi

  else
    for i in "${selection_array[@]}"; do
      hostname="${i%% *}"
      create_ssh_window "$hostname"
    done
  fi
fi
